<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="1"
  android:background="@color/close_rewarded_dialog_background"
  android:layout_width="-1"
  android:layout_height="-2">
  <TextView
    android:textSize="22sp"
    android:textColor="@color/close_rewarded_title_color"
    android:ellipsize="3"
    android:layout_gravity="0x800003"
    android:id="@id/skip_dialog_title_textview"
    android:layout_width="-2"
    android:layout_height="-2"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    android:text="@string/skip_rewarded_dialog_title"
    android:maxLines="1">
  </TextView>
  <TextView
    android:textSize="18sp"
    android:textColor="@color/close_rewarded_sub_title_color"
    android:ellipsize="3"
    android:layout_gravity="0x1"
    android:id="@id/skip_dialog_sub_title_textview"
    android:layout_width="-2"
    android:layout_height="-2"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginBottom="16dp"
    android:text="@string/skip_rewarded_dialog_sub_title">
  </TextView>
  <LinearLayout
    android:layout_gravity="0x800005"
    android:orientation="0"
    android:layout_width="-2"
    android:layout_height="-2"
    android:layout_marginRight="8dp"
    android:layout_marginBottom="16dp">
    <Button
      android:textStyle="0x1"
      android:textColor="@color/close_rewarded_button_color"
      android:ellipsize="3"
      android:id="@id/close_button"
      android:background="@color/close_rewarded_button_background_color"
      android:layout_width="-2"
      android:layout_height="-2"
      android:layout_marginRight="16dp"
      android:text="@string/skip_rewarded_dialog_close_button"
      android:maxLines="1"
      android:textAllCaps="false">
    </Button>
    <Button
      android:textStyle="0x1"
      android:textColor="@color/close_rewarded_button_color"
      android:ellipsize="3"
      android:id="@id/keep_watching_button"
      android:background="@color/close_rewarded_button_background_color"
      android:layout_width="-2"
      android:layout_height="-2"
      android:text="@string/skip_rewarded_dialog_keep_watching"
      android:maxLines="1"
      android:textAllCaps="false">
    </Button>
  </LinearLayout>
</LinearLayout>
