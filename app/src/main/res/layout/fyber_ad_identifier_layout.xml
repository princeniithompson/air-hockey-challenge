<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="0"
  android:layout_width="-2"
  android:layout_height="-2">
  <TextView
    android:textSize="@dimen/identifier_text_text_size"
    android:textColor="@0x0106000b"
    android:gravity="0x11"
    android:id="@id/fyber_identifier_text"
    android:background="@color/fyber_identifier_bg_color"
    android:layout_width="@dimen/identifier_text_width"
    android:layout_height="@dimen/identifier_text_height"
    android:text="@string/ad_identifier">
  </TextView>
  <ImageView
    android:id="@id/fyber_identifier_image"
    android:background="@color/fyber_identifier_bg_color"
    android:layout_width="@dimen/identifier_image_width"
    android:layout_height="@dimen/identifier_image_height"
    android:src="@drawable/fyber_info_button"
    android:tint="@color/fyber_white">
  </ImageView>
</LinearLayout>
